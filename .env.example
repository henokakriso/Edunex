# Edunex Environment Configuration
# Copy this file to .env and fill in your values
# The installer (php database/install.php --root-pass=XXX) generates .env automatically

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=edunex
DB_USER=edunex
DB_PASS=

# Application
APP_ENV=production
APP_URL=http://localhost:8080
